# Production settings for the aaPanel server. Copy this to .env on the server and fill in every <...> value.
# Never commit the real .env.

PORT=5000
# Only accept connections from aaPanel's Nginx reverse proxy, which forwards https://bihar-setu-backend.fillipsoftware.com here.
HOST=127.0.0.1
# One proxy (Nginx) sits in front of the API, so rate limits use the visitor's real IP.
TRUST_PROXY=1

# The server's MongoDB requires a login. Create the database and user in aaPanel -> Databases -> MongoDB,
# then use that user here. Add ?authSource=admin only if the user was created in the "admin" database instead.
MONGODB_URI=mongodb://<db-user>:<db-password>@127.0.0.1:27017/bihar_setu

# The website origins allowed to call the API (both with and without www).
CORS_ORIGINS=https://biharsetu.in,https://www.biharsetu.in

# Admin panel login. It is re-applied on every start, so changing it here and restarting resets the password.
ADMIN_EMAIL=admin@biharsetu.in
ADMIN_PASSWORD=<strong-unique-password>
# Generate a fresh one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<random-64+-character-string>

# Optional. When empty, uploaded images are saved in server/uploads on this server.
CLOUDINARY_URL=

# Reserved for password reset emails. The API does not read these yet.
APP_URL=https://bihar-setu-backend.fillipsoftware.com
FRONTEND_URL=https://biharsetu.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bihar Setu <no-reply@biharsetu.in>
